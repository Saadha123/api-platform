# LLM SDK Test Suite Configuration
# ----------------------------------
# Copy this file to config.yaml and fill in your values.
# Create providers/proxies in the AI workspace UI first, then fill in
# the IDs and gateway-generated API keys here.
#
# Usage:
#   cp config.yaml.example config.yaml
#   # edit config.yaml
#   pytest tests/

# ── Global ────────────────────────────────────────────────────────────────────

# Set to true to skip TLS certificate verification (for dev gateways with
# self-signed certs).
verify_ssl: true

# ── Providers ─────────────────────────────────────────────────────────────────
# For each provider:
#   enabled   - set to true to run tests for this provider
#   base_url  - the full URL the SDK should use as its base.
#               Tip: this is your gateway URL + the context you set in the UI.
#               For OpenAI-compatible providers include /v1 at the end.
#   api_key   - the API key generated by the AI workspace for this provider
#   models    - list of model IDs to test (tests are run once per model)

providers:

  openai:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>/v1"
    api_key: "gw_..."
    models:
      - "gpt-4o-mini"
      - "gpt-4.1-mini"

  azure_openai:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    # Azure-specific: deployment name and API version
    deployment: "gpt-4"
    api_version: "2024-05-01-preview"
    models:
      - "gpt-4"

  anthropic:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "claude-3-5-sonnet-20241022"
      - "claude-3-opus-20240229"

  gemini:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "gemini-1.5-flash"
      - "gemini-1.5-pro"

  mistral:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "mistral-small-latest"
      - "mistral-large-latest"

  # AWS Bedrock: the gateway authenticates the client with api_key and uses
  # its own AWS credentials upstream.  boto3 is configured with unsigned
  # requests so it does not add AWS SigV4; the gateway API key is injected
  # via the X-API-Key header instead.
  bedrock:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    region: "us-east-1"
    models:
      - "amazon.titan-text-premier-v1:0"
      - "anthropic.claude-v2"

  # Meta (Llama) - exposed as an OpenAI-compatible endpoint by the gateway.
  meta:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>/v1"
    api_key: "gw_..."
    models:
      - "us.meta.llama3-3-70b-instruct-v1:0"

# ── Proxies ───────────────────────────────────────────────────────────────────
# Each proxy entry represents one LLM proxy created in the AI workspace.
# provider_type controls which SDK / request format the test uses.
# Valid provider_type values: openai, azure_openai, anthropic, gemini, mistral,
#                              bedrock, meta

proxies:
  - name: "My OpenAI Proxy"
    enabled: false
    proxy_id: "my-openai-proxy-id"
    provider_type: "openai"
    base_url: "https://<gateway-host>/<proxy-context>/v1"
    api_key: "gw_..."
    models:
      - "gpt-4o-mini"

  - name: "My Anthropic Proxy"
    enabled: false
    proxy_id: "my-anthropic-proxy-id"
    provider_type: "anthropic"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "claude-3-5-sonnet-20241022"

  - name: "My Gemini Proxy"
    enabled: false
    proxy_id: "my-gemini-proxy-id"
    provider_type: "gemini"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "gemini-1.5-flash"

  - name: "My Mistral Proxy"
    enabled: false
    proxy_id: "my-mistral-proxy-id"
    provider_type: "mistral"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "mistral-small-latest"
