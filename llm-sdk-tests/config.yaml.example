# LLM SDK Test Suite Configuration
# ----------------------------------
# Copy this file to config.yaml and fill in your values.
# Create providers/proxies in the AI workspace UI first, then fill in
# the IDs and gateway-generated API keys here.
#
# Usage:
#   cp config.yaml.example config.yaml
#   # edit config.yaml
#   pytest tests/

# ── Global ────────────────────────────────────────────────────────────────────

# Set to true to skip TLS certificate verification (for dev gateways with
# self-signed certs).
verify_ssl: true

# ── Providers ─────────────────────────────────────────────────────────────────
# For each provider:
#   enabled   - set to true to run tests for this provider
#   base_url  - the full URL the SDK should use as its base.
#               Tip: this is your gateway URL + the context you set in the UI.
#               For OpenAI-compatible providers include /v1 at the end.
#   api_key   - the API key generated by the AI workspace for this provider
#   models    - list of model IDs to test (tests are run once per model)

providers:

  openai:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>/v1"
    api_key: "gw_..."
    models:
      - "gpt-4.1-nano"
      - "gpt-4.1-mini"

  azure_openai:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    api_version: "2024-06-01"
    models:
      - "<azure-deployment-name>"   # Azure deployment name (used as the deployment in the URL)

  anthropic:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "claude-sonnet-4-5"
      - "claude-opus-4-6"

  gemini:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "gemini-2.5-flash"
      - "gemini-2.5-pro"

  mistral:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    models:
      - "mistral-small-latest"
      - "mistral-large-latest"

  # Azure AI Foundry – supports both OpenAI SDK (AzureOpenAI) and the
  # azure-ai-inference SDK (ChatCompletionsClient).
  # Configure upstream: https://<resource>.cognitiveservices.azure.com
  azure_foundry:
    enabled: false
    base_url: "https://<gateway-host>/<provider-context>"
    api_key: "gw_..."
    api_version: "2024-05-01-preview"
    models:
      - "<azure-deployment-name>"



# ── Proxies ───────────────────────────────────────────────────────────────────
# Each proxy entry represents one LLM proxy created in the AI workspace.
# provider_type controls which SDK / request format the test uses.
# Valid provider_type values: openai, azure_openai, anthropic, gemini, mistral,
#                              bedrock, meta, azure_foundry

proxies:
  - name: "My Mistral Proxy"
    enabled: false
    provider_type: "mistral"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "mistral-small-latest"

  - name: "My Anthropic Proxy"
    enabled: false
    provider_type: "anthropic"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "claude-sonnet-4-5"
      - "claude-opus-4-6"

  - name: "My Gemini Proxy"
    enabled: false
    provider_type: "gemini"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    models:
      - "gemini-2.5-flash"

  - name: "My OpenAI Proxy"
    enabled: false
    provider_type: "openai"
    base_url: "https://<gateway-host>/<proxy-context>/v1"
    api_key: "gw_..."
    models:
      - "gpt-4.1-nano"

  - name: "My Azure OpenAI Proxy"
    enabled: false
    provider_type: "azure_openai"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    api_version: "2024-06-01"
    models:
      - "<azure-deployment-name>"

  # Azure AI Foundry – supports OpenAI SDK (AzureOpenAI), azure-ai-inference SDK
  # (ChatCompletionsClient), and LangChain (AzureAIChatCompletionsModel).
  # Configure upstream: https://<resource>.cognitiveservices.azure.com
  - name: "My Azure Foundry Proxy"
    enabled: false
    provider_type: "azure_foundry"
    base_url: "https://<gateway-host>/<proxy-context>"
    api_key: "gw_..."
    api_version: "2024-05-01-preview"
    models:
      - "<azure-deployment-name>"
